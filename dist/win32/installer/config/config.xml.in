<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>EuclidRUI</Name>
    <Version>@VERSION_STRING@</Version>
    <Title>Euclid Rich UI Installer</Title>
    <Publisher>Dr. Jens Vogt</Publisher>
    <StartMenuDir>euclid</StartMenuDir>
    <!-- @ApplicationsDir@ is "C:\Program Files" on Windows, so this is the requested
         C:\Program Files\euclid-rui - taken from the variable rather than spelled out so a Windows
         installed on a drive other than C: still lands in its own Program Files. -->
    <TargetDir>@ApplicationsDir@/euclid-rui</TargetDir>
    <!-- Deliberately without the extension: IFW appends the platform's own (.ico here, .icns on
         macOS, .png on Linux), so naming euclid-rui.ico would have it look for euclid-rui.ico.ico.
         This is what the installer and the maintenance tool it leaves behind are shown as. -->
    <InstallerApplicationIcon>euclid-rui</InstallerApplicationIcon>
    <!-- And this one *does* carry its extension - it is a PNG on every platform. Title bar of the
         installer window. -->
    <InstallerWindowIcon>euclid-rui.png</InstallerWindowIcon>
    <RemoteRepositories>
        <Repository>
            <Url>https://jensvogt.github.io/euclid-rui</Url>
            <Enabled>true</Enabled>
        </Repository>
    </RemoteRepositories>
</Installer>
